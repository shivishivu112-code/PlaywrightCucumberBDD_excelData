    "dry-run": "cucumber-js --dry-run"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "otplib": "^12.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "exceljs": "^3.10.0"
  }
}
