BASE_URL=https://github.com
APP_USERNAME=
PASSWORD=
# Base32 secret from the authenticator setup (treat like a password)
TOTP_SECRET=
# true = no browser window, false = watch the test run
HEADLESS=true

# --- Outlook verification code (Microsoft Graph, test mailbox only) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Test mailbox that receives the code, e.g. qa.otp@yourcompany.com
OTP_MAILBOX=
# How that address is shown on the "choose where to send the code" screen (may be masked)
OTP_EMAIL_HINT=
# Optional: only read emails from this sender, and a custom pattern for the code
OTP_SENDER=
OTP_REGEX=
